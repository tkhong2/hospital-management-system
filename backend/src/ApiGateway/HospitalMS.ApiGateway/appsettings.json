{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Seq"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Yarp": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "serverUrl": "http://localhost:5341" } }
    ],
    "Properties": {
      "Application": "HospitalMS.ApiGateway"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/identity/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/identity" } ]
      },
      "patient-route": {
        "ClusterId": "patient-cluster",
        "Match": { "Path": "/patient/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/patient" } ]
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/catalog/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/catalog" } ]
      },
      "outpatient-route": {
        "ClusterId": "outpatient-cluster",
        "Match": { "Path": "/outpatient/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/outpatient" } ]
      },
      "inpatient-route": {
        "ClusterId": "inpatient-cluster",
        "Match": { "Path": "/inpatient/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/inpatient" } ]
      },
      "pharmacy-route": {
        "ClusterId": "pharmacy-cluster",
        "Match": { "Path": "/pharmacy/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/pharmacy" } ]
      },
      "healthexam-route": {
        "ClusterId": "healthexam-cluster",
        "Match": { "Path": "/healthexam/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/healthexam" } ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5101/" } }
      },
      "patient-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5102/" } }
      },
      "catalog-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5103/" } }
      },
      "outpatient-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5104/" } }
      },
      "inpatient-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5105/" } }
      },
      "pharmacy-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5106/" } }
      },
      "healthexam-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5107/" } }
      }
    }
  },
  "AllowedHosts": "*"
}
