{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Seq"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"],
    "Properties": {
      "Application": "HospitalMS.Identity"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=hospitalms_identity;Username=postgres;Password=postgres123"
  },
  "DatabaseProvider": "PostgreSQL",
  "Jwt": {
    "Secret": "YourSuperSecretKeyForHospitalMSJwtTokenGeneration2024!@#$%",
    "Issuer": "HospitalMS",
    "Audience": "HospitalMS.Client",
    "ExpiryMinutes": 60,
    "RefreshExpiryDays": 7
  },
  "AllowedHosts": "*"
}
